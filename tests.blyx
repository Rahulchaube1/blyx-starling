use std::cli;
use starling;

fn matches(actual: vector, expected: vector) -> bool {
    if len(actual) != len(expected) { return false; }
    let mut i = 0;
    while i < len(expected) {
        let delta = at(actual, i) - at(expected, i);
        let limit = 0.000000001 + 0.000000001 * at(expected, i) * at(expected, i) / (1.0 + at(expected, i) * at(expected, i));
        if !(delta >= -limit && delta <= limit) { return false; }
        i += 1;
    }
    true
}

fn main() {
    let infinity = 1.0e300 * 1.0e300;
    if !matches(starling_capacity([0, 2, 4], [4, 5, 7], 1.0), [7, 2, 2, 1]) { stderr_line("case 1 failed"); process_exit(1); }
    if !matches(starling_capacity([1, 3], [3, 5], 1.0), [4, 1, 1, 0]) { stderr_line("case 2 failed"); process_exit(1); }
    if !matches(starling_capacity([], [], 2.0), [0, 0, 0, 0]) { stderr_line("case 3 failed"); process_exit(1); }
    if !matches(starling_capacity([3], [2], 1.0), []) { stderr_line("case 4 failed"); process_exit(1); }
    if !matches(starling_capacity([infinity], [4, 5, 7], 1.0), []) { stderr_line("case 5 failed"); process_exit(1); }
    if !matches(starling_capacity([0, 2, 4], [infinity], 1.0), []) { stderr_line("case 6 failed"); process_exit(1); }
    if !matches(starling_capacity([0, 2, 4], [4, 5, 7], infinity), []) { stderr_line("case 7 failed"); process_exit(1); }
    println!("passed");
}
