use std::cli;
use console;
use starling;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Estimate resource capacity and actual occupied time from a booking schedule.");
        println!("Usage: starling starts ends capacity");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = starling_capacity([0, 2, 4], [4, 5, 7], 1.0);
    } else {
        if count != 3 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let starts = console_vector(args_at(argv, 0));
        let ends = console_vector(args_at(argv, 1));
        let capacity = console_value(args_at(argv, 2));
        result = starling_capacity(starts, ends, capacity);
    }
    if len(result) == 0 { stderr_line("Invalid input for Starling. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
